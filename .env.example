# Copy to .env.local and fill in as each piece becomes available.
# Every value here is safe to expose in the browser bundle — that's what
# NEXT_PUBLIC_ means. Never add a private secret to this file.

# Base URL of the future Flask REST API, e.g. https://api.guideguruglobal.com
# Leave empty for local development: every services/*Service.ts method
# falls back to demo/mock behavior when this is unset, so the full guest
# flow (browse, book, query, contact) still works end to end without a
# backend. Setting this is the main step to go live — see API_INTEGRATION.md.
NEXT_PUBLIC_API_URL=

# Cloudflare Turnstile SITE key (public — the secret key is NOT this).
# Leave empty to skip the human-verification gate in local development.
# Create one at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --------------------------------------------------------------------------
# NEVER put any of the following in this file, in a NEXT_PUBLIC_* variable,
# or anywhere in this frontend. They belong only in the Flask backend's own
# environment, once it exists:
#
#   TURNSTILE_SECRET_KEY
#   DATABASE_URL / DATABASE_PASSWORD
#   PAYMENT_SECRET_KEY
#   WEBHOOK_SECRET
#   JWT_SECRET
#   Any other private API key or credential
# --------------------------------------------------------------------------
